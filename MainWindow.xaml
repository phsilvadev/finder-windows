<Window x:Class="EspacoLivre.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Espaço Livre" Width="1440" Height="940" MinWidth="1080" MinHeight="720" Background="#0A1323" Foreground="#EEF4FF" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
<Border BorderBrush="#34465F" BorderThickness="1" CornerRadius="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#0E1B2E" CornerRadius="12,0,0,12"><DockPanel><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="25,49,0,35"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEDA2;" Foreground="#67BFFF" FontSize="30" Margin="0,0,12,0"/><TextBlock Text="Espaço Livre" FontSize="23" FontWeight="Bold"/></StackPanel><RadioButton Style="{StaticResource Nav}" GroupName="Navigation" Tag="0" Checked="Navigate_Click" IsChecked="True" ><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="22" Margin="0,0,18,0"/><TextBlock Text="Visão geral"/></StackPanel></RadioButton><RadioButton Style="{StaticResource Nav}" GroupName="Navigation" Tag="1" Checked="Navigate_Click" ><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="22" Margin="0,0,18,0"/><TextBlock Text="Arquivos grandes"/></StackPanel></RadioButton><RadioButton Style="{StaticResource Nav}" GroupName="Navigation" Tag="2" Checked="Navigate_Click" ><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="22" Margin="0,0,18,0"/><TextBlock Text="Pastas"/></StackPanel></RadioButton><RadioButton Style="{StaticResource Nav}" GroupName="Navigation" Tag="3" Checked="Navigate_Click" ><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA99;" FontSize="22" Margin="0,0,18,0"/><TextBlock Text="Limpeza"/></StackPanel></RadioButton><RadioButton Style="{StaticResource Nav}" GroupName="Navigation" Tag="4" Checked="Navigate_Click" ><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="22" Margin="0,0,18,0"/><TextBlock Text="Configurações"/></StackPanel></RadioButton></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="Seu espaço, organizado." Foreground="#6F849F" Margin="25,0,0,25" VerticalAlignment="Bottom"/></DockPanel></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Click="Minimize_Click" Background="Transparent" BorderThickness="0" Padding="17,8"/><Button Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Click="Maximize_Click" Background="Transparent" BorderThickness="0" Padding="17,8"/><Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Click="Close_Click" Background="Transparent" BorderThickness="0" Padding="17,8"/></StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="27,12,25,18">
<Grid><StackPanel><TextBlock Text="Seu SSD, sob controle" FontSize="38" FontWeight="Bold"/><TextBlock Text="Veja o que ocupa espaço e escolha o que liberar." Foreground="{StaticResource Muted}" FontSize="18" Margin="0,5,0,0"/></StackPanel><Button x:Name="ScanButton" Content="⌕   Analisar SSD" Click="Scan_Click" Background="#087FEF" BorderBrush="#37A5FF" FontSize="18" Padding="23,12" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
<Grid Margin="0,22,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#19273B" BorderBrush="#41536C" BorderThickness="1" CornerRadius="8" Padding="13,8"><DockPanel><TextBlock Text="▣" Foreground="#83BDF0" Margin="0,0,10,0"/><TextBox x:Name="PathBox" Background="Transparent" BorderThickness="0" Foreground="#E9F2FF" VerticalContentAlignment="Center" ToolTip="Pasta ou unidade para analisar"/></DockPanel></Border><Button Grid.Column="1" x:Name="ChooseButton" Content="Escolher pasta" Click="Choose_Click" Margin="10,0,0,0"/><Button Grid.Column="2" x:Name="CancelButton" Content="Cancelar" Click="Cancel_Click" Visibility="Collapsed" Margin="10,0,0,0"/></Grid>
<Grid Margin="0,0,0,10"><TextBlock x:Name="UsedText" FontSize="34" FontWeight="Bold"/><TextBlock x:Name="FreeText" FontSize="19" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5"/></Grid>
<Border CornerRadius="8" Background="#35435B" ClipToBounds="True"><Grid Height="25"><ProgressBar x:Name="DriveBar" Visibility="Collapsed"/><Grid x:Name="StorageSegments"/></Grid></Border>
<WrapPanel x:Name="LegendPanel" Margin="0,12,0,4"/><TextBlock x:Name="DriveText" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="SummaryText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,16"/><ProgressBar x:Name="ScanProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,12"/>
<Grid x:Name="OverviewPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Onde está o espaço?" Style="{StaticResource Heading}"/><Grid Grid.Row="1" Height="245"><Canvas x:Name="MapCanvas" SizeChanged="Map_SizeChanged"/><StackPanel x:Name="MapEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="42" Foreground="#4C89C0" HorizontalAlignment="Center"/><TextBlock Text="Descubra o que ocupa seu SSD" FontSize="17" Margin="0,15,0,7"/><TextBlock Text="Clique em Analisar SSD para ver o mapa." Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center"/></StackPanel></Grid></Grid></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Maiores pastas" Style="{StaticResource Heading}"/><StackPanel x:Name="TopFoldersPanel"/><TextBlock x:Name="FoldersEmpty" Text="Suas maiores pastas aparecerão aqui após a análise." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,60,0,0"/></StackPanel></Border></Grid>
<Border x:Name="FilesPanel" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,0,0,16"><StackPanel><TextBlock Text="Arquivos grandes" Style="{StaticResource Heading}"/><DataGrid x:Name="FileGrid" Height="285"><DataGrid.Columns><DataGridTextColumn Header="Arquivo" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" SortMemberPath="Bytes" Width="110"/><DataGridTextColumn Header="Localização" Binding="{Binding Path}" Width="3*"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button x:Name="OpenButton" Content="Abrir localização" Click="Open_Click" Margin="0,0,10,0"/><Button x:Name="TrashButton" Content="Enviar à Lixeira…" Click="Trash_Click"/></StackPanel></StackPanel></Border>
<Border x:Name="FolderListPanel" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel><TextBlock Text="Explorar pastas" Style="{StaticResource Heading}"/><DataGrid x:Name="FolderGrid" Height="285" MouseDoubleClick="Folder_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Pasta" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" SortMemberPath="Bytes" Width="110"/><DataGridTextColumn Header="Localização" Binding="{Binding Path}" Width="3*"/></DataGrid.Columns></DataGrid></StackPanel></Border>
<Border x:Name="CleanupPanel" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16"><StackPanel><TextBlock Text="Oportunidades de limpeza" Style="{StaticResource Heading}" Margin="4,0,0,14"/><UniformGrid Columns="3"><Border Style="{StaticResource Card}" Padding="15" Margin="4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C3;" FontSize="30" Foreground="#A8CFEF" Margin="0,5,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="Temporários" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Arquivos temporários dos seus aplicativos." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,7,8,0" FontSize="12"/></StackPanel><Button Grid.Column="2" Content="Revisar" Click="Temp_Click" Padding="10,8" VerticalAlignment="Center"/></Grid></Border><Border Style="{StaticResource Card}" Padding="15" Margin="4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="30" Foreground="#A8CFEF" Margin="0,5,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="Lixeira" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Revise arquivos apagados que ainda ocupam espaço." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,7,8,0" FontSize="12"/></StackPanel><Button Grid.Column="2" Content="Revisar" Click="Recycle_Click" Padding="10,8" VerticalAlignment="Center"/></Grid></Border><Border Style="{StaticResource Card}" Padding="15" Margin="4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="30" Foreground="#A8CFEF" Margin="0,5,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="Downloads" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Revise instaladores e arquivos baixados." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,7,8,0" FontSize="12"/></StackPanel><Button Grid.Column="2" Content="Revisar" Click="Downloads_Click" Padding="10,8" VerticalAlignment="Center"/></Grid></Border></UniformGrid></StackPanel></Border>
<Border x:Name="SettingsPanel" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel><TextBlock Text="Configurações" Style="{StaticResource Heading}"/><TextBlock Text="Análise local • Nenhum dado enviado à internet"/><TextBlock Text="Exclusão individual com confirmação e proteção de pastas do sistema." Margin="0,12"/><Button Content="Abrir armazenamento do Windows" Click="Storage_Click" HorizontalAlignment="Left"/></StackPanel></Border>
<StackPanel Orientation="Horizontal" Margin="4,20,0,10"><TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" Foreground="#27E3CC" FontSize="22" Margin="0,0,10,0"/><TextBlock Text="Você escolhe o que excluir. Arquivos do sistema protegidos." VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="StatusText" Text="Pronto para analisar • Seus dados ficam no seu computador." Foreground="#7F94B0" FontSize="11" TextTrimming="CharacterEllipsis"/>
</StackPanel></ScrollViewer></Grid></Grid></Border></Window>