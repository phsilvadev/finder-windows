<Window x:Class="EspacoLivre.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Espaço Livre" Width="1180" Height="800" MinWidth="920" MinHeight="620" Background="#0D1728" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Espaço Livre" FontSize="16" Foreground="#52D1CE"/><TextBlock Text="Seu SSD, sob controle" FontSize="32" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Veja o que ocupa espaço e escolha o que liberar." Foreground="#A4B4CC"/></StackPanel>
<Grid Grid.Row="1" Margin="0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PathBox" VerticalContentAlignment="Center" Padding="12" Background="#1B2B43" Foreground="White" BorderBrush="#354D6B"/><Button Grid.Column="1" x:Name="ChooseButton" Content="Escolher pasta" Click="Choose_Click"/><Button Grid.Column="2" x:Name="ScanButton" Content="Analisar" Click="Scan_Click"/><Button Grid.Column="3" x:Name="CancelButton" Content="Cancelar" IsEnabled="False" Click="Cancel_Click"/></Grid>
<Border Grid.Row="2" Background="#162338" CornerRadius="12" Padding="18" Margin="0,0,0,18"><StackPanel><TextBlock x:Name="DriveText" FontSize="19" FontWeight="SemiBold"/><ProgressBar x:Name="DriveBar" Height="12" Margin="0,12" Foreground="#25BDB9" Background="#30425C"/><TextBlock x:Name="SummaryText" Text="Escolha uma pasta ou uma unidade para começar." Foreground="#A4B4CC"/><ProgressBar x:Name="ScanProgress" Height="3" Margin="0,12,0,0" Visibility="Collapsed" IsIndeterminate="True"/></StackPanel></Border>
<TabControl Grid.Row="3" Background="#162338" BorderThickness="0"><TabItem Header="Maiores pastas"><DataGrid x:Name="FolderGrid" MouseDoubleClick="Folder_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Pasta" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" Width="130" SortMemberPath="Bytes"/><DataGridTextColumn Header="Localização" Binding="{Binding Path}" Width="3*"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Maiores arquivos"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="FileGrid"><DataGrid.Columns><DataGridTextColumn Header="Arquivo" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" Width="110" SortMemberPath="Bytes"/><DataGridTextColumn Header="Localização" Binding="{Binding Path}" Width="3*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OpenButton" Content="Abrir localização" Click="Open_Click"/><Button x:Name="TrashButton" Content="Enviar à Lixeira…" Click="Trash_Click" Background="#833D52"/></StackPanel></Grid></TabItem><TabItem Header="Limpeza"><StackPanel Margin="24"><TextBlock Text="Revise antes de liberar espaço" FontSize="24" FontWeight="Bold"/><TextBlock Text="Analise uma destas pastas para encontrar arquivos que você pode revisar." Margin="0,10,0,20"/><Button Content="Analisar Downloads" Click="Downloads_Click" HorizontalAlignment="Left"/><Button Content="Analisar temporários do usuário" Click="Temp_Click" HorizontalAlignment="Left"/><Button Content="Abrir armazenamento do Windows" Click="Storage_Click" HorizontalAlignment="Left"/><TextBlock Text="O app nunca limpa pastas automaticamente. A exclusão está disponível apenas para arquivos selecionados." TextWrapping="Wrap" Margin="0,20" Foreground="#A4B4CC"/></StackPanel></TabItem></TabControl>
<TextBlock Grid.Row="4" x:Name="StatusText" Text="Pronto • Análise local, sem envio de dados." Margin="0,14,0,0" Foreground="#A4B4CC" TextTrimming="CharacterEllipsis"/>
</Grid></Window>